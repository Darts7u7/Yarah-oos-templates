# Yarah Configuration
# Get these values from your Yarah dashboard: https://yarah.dev

# Your Yarah backend URL (required for authentication)
VITE_YARAH_URL=https://your-app.apps.yarah.dev

# Anonymous key (required for auth, database, and storage operations)
VITE_YARAH_ANON_KEY=your_yarah_anon_key_here

